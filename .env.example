# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/docplatform

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# The user registering with this e-mail becomes Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com

# --- File storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10

# --- Background processing ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
JOB_MAX_ATTEMPTS=3
EXPIRY_NOTICE_DAYS=30
REVIEW_REMINDER_HOURS=24
REVIEW_ESCALATION_HOURS=72

# --- E-mail (optional) ---
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@docplatform.local

# --- Dev only ---
AUTO_CREATE_TABLES=false
BCRYPT_ROUNDS=12
